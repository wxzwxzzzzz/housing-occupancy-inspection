    <ontology title="资源排班" namespace="cn.byteawake.ap.resource" serviceDomain="byteawake-ap-resource">
        <import namespace="cn.byteawake.ap.oms"/>

        <!-- ============================================ -->
        <!--  枚举                                        -->
        <!-- ============================================ -->

        <enum name="ResourceType" title="资源类型" description="可调度资源的类型分类，对齐 Odoo resource.resource.resource_type">
            <member title="人员" name="HUMAN" code="1" ordinal="0"/>
            <member title="物料" name="MATERIAL" code="2" ordinal="1"/>
        </enum>

        <enum name="Weekday" title="星期" description="一周七天的顺序编码">
            <member title="周一" name="MONDAY" code="1" ordinal="0"/>
            <member title="周二" name="TUESDAY" code="2" ordinal="1"/>
            <member title="周三" name="WEDNESDAY" code="3" ordinal="2"/>
            <member title="周四" name="THURSDAY" code="4" ordinal="3"/>
            <member title="周五" name="FRIDAY" code="5" ordinal="4"/>
            <member title="周六" name="SATURDAY" code="6" ordinal="5"/>
            <member title="周日" name="SUNDAY" code="7" ordinal="6"/>
        </enum>

        <enum name="DayPeriod" title="日内时段" description="一天中的工作时段划分">
            <member title="上午" name="MORNING" code="1" ordinal="0"/>
            <member title="休息" name="BREAK" code="2" ordinal="1"/>
            <member title="下午" name="AFTERNOON" code="3" ordinal="2"/>
            <member title="全天" name="FULL_DAY" code="4" ordinal="3"/>
        </enum>

        <enum name="WeekType" title="双周类型" description="双周日历模式下的周次标识">
            <member title="第一周" name="FIRST" code="0" ordinal="0"/>
            <member title="第二周" name="SECOND" code="1" ordinal="1"/>
        </enum>

        <enum name="LeaveEffect" title="休班效果" description="日历休班安排对工作时间计算的影响效果，TIME_OFF 扣除时间，MAKE_UP_WORKDAY 增加时间">
            <member title="休班" name="TIME_OFF" code="0" ordinal="0"/>
            <member title="补班工作日" name="MAKE_UP_WORKDAY" code="1" ordinal="1"/>
        </enum>

        <enum name="TimeType" title="时间类型" description="日历例外安排的性质分类，对齐 Odoo resource.calendar.leaves.time_type">
            <member title="缺勤" name="LEAVE" code="1" ordinal="0"/>
            <member title="其他工作安排" name="OTHER" code="2" ordinal="1"/>
        </enum>

        <enum name="ScheduleType" title="调度类型" description="日历的调度模式，对齐 Odoo resource.calendar.schedule_type">
            <member title="固定" name="FIXED" code="1" ordinal="0"/>
            <member title="弹性" name="FLEXIBLE" code="2" ordinal="1"/>
        </enum>

        <!-- ============================================ -->
        <!--  实体                                        -->
        <!-- ============================================ -->

