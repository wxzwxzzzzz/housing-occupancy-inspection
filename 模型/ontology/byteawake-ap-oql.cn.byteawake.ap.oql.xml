<?xml version="1.0" encoding="UTF-8"?>
<ontologies xmlns="http://byteawake.cn/ontology"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://byteawake.cn/ontology oms.xsd">
    <ontology title="本体查询元数据" namespace="cn.byteawake.ap.oql" serviceDomain="byteawake-ap-oql">
        <!-- ============================================ -->
        <!--  查询枚举定义                                -->
        <!-- ============================================ -->
        <enum name="QueryLogicalOperator" title="查询逻辑操作符" description="定义查询条件组的逻辑组合关系">
            <member name="AND" code="10" title="且"/>
            <member name="OR" code="20" title="或"/>
        </enum>

        <enum name="QueryComparisonOperator" title="查询比较操作符" description="定义查询条件支持的比较方式">
            <member name="EQ" code="10" title="等于"/>
            <member name="NE" code="20" title="不等于"/>
            <member name="GT" code="30" title="大于"/>
            <member name="GE" code="40" title="大于等于"/>
            <member name="LT" code="50" title="小于"/>
            <member name="LE" code="60" title="小于等于"/>
            <member name="LIKE" code="70" title="包含"/>
            <member name="IN" code="80" title="包含于"/>
            <member name="BETWEEN" code="90" title="区间"/>
            <member name="IS_NULL" code="100" title="为空"/>
            <member name="NOT_NULL" code="110" title="不为空"/>
        </enum>

        <enum name="QuerySortDirection" title="查询排序方向" description="定义查询排序方向">
            <member name="ASC" code="10" title="升序"/>
            <member name="DESC" code="20" title="降序"/>
        </enum>

        <enum name="TreeQueryScope" title="树查询范围" description="定义树查询的遍历范围">
            <member name="ROOT_CHILDREN" code="10" title="根节点子级"/>
            <member name="SUBTREE" code="20" title="子树"/>
            <member name="ANCESTORS" code="30" title="祖先路径"/>
        </enum>

        <!-- ============================================ -->
        <!--  查询对象定义                                -->
        <!-- ============================================ -->
        <class title="查询条件项" name="QueryFilterCondition" isPersistent="false">
            <attributes>
                <attribute title="查询路径" name="field" field="field" type="String" isRequired="true"/>
                <attribute title="比较操作符" name="operator" field="operator" type="cn.byteawake.ap.oql.QueryComparisonOperator" isRequired="true"/>
                <attribute title="条件值1" name="value1" field="value1" type="String"/>
                <attribute title="条件值2" name="value2" field="value2" type="String"/>
                <attribute title="条件值列表" name="values" field="values" type="Any" isCollection="true"/>
            </attributes>
        </class>

        <class title="查询条件组" name="QueryFilterGroup" isPersistent="false">
            <attributes>
                <attribute title="逻辑操作符" name="operator" field="operator" type="cn.byteawake.ap.oql.QueryLogicalOperator" isRequired="true"/>
            </attributes>
        </class>

        <class title="查询排序项" name="QuerySortItem" isPersistent="false">
            <attributes>
                <attribute title="查询路径" name="path" field="path" type="String" isRequired="true"/>
                <attribute title="排序方向" name="direction" field="direction" type="cn.byteawake.ap.oql.QuerySortDirection" isRequired="true"/>
            </attributes>
        </class>

        <class title="查询分页" name="QueryPage" isPersistent="false">
            <attributes>
                <attribute title="页码" name="pageNo" field="page_no" type="Integer"/>
                <attribute title="页大小" name="pageSize" field="page_size" type="Integer"/>
                <attribute title="向前条数" name="first" field="first" type="Integer"/>
                <attribute title="起始游标" name="after" field="after" type="String"/>
                <attribute title="向后条数" name="last" field="last" type="Integer"/>
                <attribute title="结束游标" name="before" field="before" type="String"/>
            </attributes>
        </class>

        <class title="查询声明" name="QuerySpec" isPersistent="false">
            <attributes>
                <attribute title="目标本体" name="objectType" field="object_type" type="String" isRequired="true"/>
                <attribute title="查询字段" name="selection" field="selection" type="Text"/>
                <attribute title="过滤条件" name="filter" field="filter" type="cn.byteawake.ap.oql.QueryFilterGroup"/>
                <attribute title="聚合指标" name="metrics" field="metrics" type="Text"/>
                <attribute title="分组维度" name="dimensions" field="dimensions" type="Text"/>
                <attribute title="聚合后过滤" name="having" field="having" type="cn.byteawake.ap.oql.QueryFilterGroup"/>
            </attributes>
        </class>

        <!-- ============================================ -->
        <!--  动作声明定义                                -->
        <!-- ============================================ -->
        <class title="动作声明" name="ActionSpec" isPersistent="false">
            <attributes>
                <attribute title="目标本体" name="objectType" field="object_type" type="String" isRequired="true"/>
                <attribute title="动作名称" name="actionName" field="action_name" type="String" isRequired="true"/>
            </attributes>
        </class>

        <class title="树查询选项" name="TreeQueryOptions" isPersistent="false">
            <attributes>
                <attribute title="根节点标识" name="rootId" field="root_id" type="String"/>
                <attribute title="父节点标识" name="parentId" field="parent_id" type="String"/>
                <attribute title="最大层级" name="maxDepth" field="max_depth" type="Integer"/>
                <attribute title="是否包含根节点" name="includeRoot" field="include_root" type="Boolean" defaultValue="false"/>
                <attribute title="是否递归" name="recursive" field="recursive" type="Boolean" defaultValue="true"/>
                <attribute title="查询范围" name="scope" field="scope" type="cn.byteawake.ap.oql.TreeQueryScope"/>
            </attributes>
        </class>

        <links>
            <link title="查询声明排序项" name="querySpecSort" semantic="COMPOSITION">
                <subject name="spec" title="查询声明" type="cn.byteawake.ap.oql.QuerySpec" multiplicity="1"/>
                <object name="sortItems" title="排序项" type="cn.byteawake.ap.oql.QuerySortItem" multiplicity="0..*"/>
            </link>
            <link title="查询声明分页信息" name="querySpecPage" semantic="COMPOSITION">
                <subject name="spec" title="查询声明" type="cn.byteawake.ap.oql.QuerySpec" multiplicity="1"/>
                <object name="page" title="查询分页" type="cn.byteawake.ap.oql.QueryPage" multiplicity="0..1"/>
            </link>
            <link title="查询声明树查询选项" name="querySpecTreeOptions" semantic="COMPOSITION">
                <subject name="spec" title="查询声明" type="cn.byteawake.ap.oql.QuerySpec" multiplicity="1"/>
                <object name="treeOptions" title="树查询选项" type="cn.byteawake.ap.oql.TreeQueryOptions" multiplicity="0..1"/>
            </link>
            <link title="过滤条件组条件项" name="queryFilterConditions" semantic="COMPOSITION">
                <subject name="group" title="过滤条件组" type="cn.byteawake.ap.oql.QueryFilterGroup" multiplicity="1"/>
                <object name="conditions" title="条件项" type="cn.byteawake.ap.oql.QueryFilterCondition" multiplicity="0..*"/>
            </link>
            <link title="过滤条件组子组" name="queryFilterGroups" semantic="COMPOSITION">
                <subject name="group" title="过滤条件组" type="cn.byteawake.ap.oql.QueryFilterGroup" multiplicity="1"/>
                <object name="groups" title="子过滤条件组" type="cn.byteawake.ap.oql.QueryFilterGroup" multiplicity="0..*"/>
            </link>
            <link title="动作声明载荷" name="actionSpecPayload" semantic="COMPOSITION">
                <subject name="spec" title="动作声明" type="cn.byteawake.ap.oql.ActionSpec" multiplicity="1"/>
                <object name="payload" title="动作载荷" type="cn.byteawake.ap.oms.OntologyObject" multiplicity="0..1"/>
            </link>
        </links>
    </ontology>
</ontologies>
