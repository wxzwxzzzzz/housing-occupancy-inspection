<?xml version="1.0" encoding="UTF-8"?>
<ontologies xmlns="http://byteawake.cn/ontology"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://byteawake.cn/ontology oms.xsd">

    <ontology title="基础档案" namespace="cn.byteawake.ap.basedoc" serviceDomain="byteawake-ap-basedoc">
        <import namespace="cn.byteawake.ap.oms"/>

        <!-- ============================================ -->
        <!--  枚举                                        -->
        <!-- ============================================ -->

        <enum name="RegionType" title="行政区划类型" description="按国标覆盖五级行政区域类型，code前缀编码层级">
            <!-- 省级 1x -->
            <member title="省" name="PROVINCE" code="11" ordinal="0"/>
            <member title="自治区" name="AUTONOMOUS_REGION" code="12" ordinal="1"/>
            <member title="直辖市" name="MUNICIPALITY" code="13" ordinal="2"/>
            <member title="特别行政区" name="SAR" code="14" ordinal="3"/>
            <!-- 地级 2x -->
            <member title="地级市" name="PREFECTURE_CITY" code="21" ordinal="4"/>
            <member title="地区" name="PREFECTURE" code="22" ordinal="5"/>
            <member title="自治州" name="AUTONOMOUS_PREFECTURE" code="23" ordinal="6"/>
            <member title="盟" name="LEAGUE" code="24" ordinal="7"/>
            <!-- 县级 3x -->
            <member title="市辖区" name="DISTRICT" code="31" ordinal="8"/>
            <member title="县" name="COUNTY" code="32" ordinal="9"/>
            <member title="县级市" name="COUNTY_CITY" code="33" ordinal="10"/>
            <member title="自治县" name="AUTONOMOUS_COUNTY" code="34" ordinal="11"/>
            <member title="旗" name="BANNER" code="35" ordinal="12"/>
            <member title="自治旗" name="AUTONOMOUS_BANNER" code="36" ordinal="13"/>
            <member title="特区" name="SPECIAL_DISTRICT" code="37" ordinal="14"/>
            <member title="林区" name="FORESTRY_AREA" code="38" ordinal="15"/>
            <!-- 乡级 4x -->
            <member title="街道" name="SUBDISTRICT" code="41" ordinal="16"/>
            <member title="镇" name="TOWN" code="42" ordinal="17"/>
            <member title="乡" name="TOWNSHIP" code="43" ordinal="18"/>
            <member title="民族乡" name="ETHNIC_TOWNSHIP" code="44" ordinal="19"/>
            <member title="苏木" name="SUM" code="45" ordinal="20"/>
            <member title="民族苏木" name="ETHNIC_SUM" code="46" ordinal="21"/>
            <!-- 村级 5x -->
            <member title="居委会" name="NEIGHBORHOOD_COMMITTEE" code="51" ordinal="22"/>
            <member title="村委会" name="VILLAGE_COMMITTEE" code="52" ordinal="23"/>
            <member title="类似村级单位" name="SIMILAR_VILLAGE_UNIT" code="53" ordinal="24"/>
        </enum>

        <!-- ============================================ -->
        <!--  实体                                        -->
        <!-- ============================================ -->

        <class title="行政区划" name="AdministrativeRegion" dataSet="ap_basedoc_admin_region">
            <extends>
                <super class="cn.byteawake.ap.oms.OntologyObject"/>
            </extends>
            <implements>
                <supplier itf="cn.byteawake.ap.oms.ITree"/>
                <supplier itf="cn.byteawake.ap.oms.ITenant"/>
                <supplier itf="cn.byteawake.ap.oms.IAuditInfo"/>
                <supplier itf="cn.byteawake.ap.oms.IEnable"/>
                <supplier itf="cn.byteawake.ap.oms.ISysPreset"/>
                <supplier itf="cn.byteawake.ap.oms.ILogicDelete"/>
                <supplier itf="cn.byteawake.ap.oms.ITimeline"/>
            </implements>
            <attributes>
                <attribute title="编码" name="code" field="code" type="String" length="64" isRequired="true"/>
                <attribute title="国标码" name="nationalCode" field="national_code" type="String" length="32" isRequired="true"/>
                <attribute title="国家码" name="countryCode" field="country_code" type="String" length="32" isRequired="true"/>
                <attribute title="区划类型" name="regionType" field="region_type" type="cn.byteawake.ap.basedoc.RegionType" isRequired="true"/>
                <attribute title="简称" name="shortName" field="short_name" type="String" length="64"/>
                <attribute title="拼音" name="pinyin" field="pinyin" type="String" length="256"/>
                <attribute title="拼音缩写" name="pinyinShort" field="pinyin_short" type="String" length="64"/>
                <attribute title="中心点经度" name="longitude" field="longitude" type="Decimal" precision="10" scale="6"/>
                <attribute title="中心点纬度" name="latitude" field="latitude" type="Decimal" precision="10" scale="6"/>
            </attributes>
            <actions>
                <action name="add" title="新增区划" kind="add"
                        requestType="cn.byteawake.ap.basedoc.AdministrativeRegion">
                    <parameters>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.code">
                            <availability visible="true" enable="true" required="true" editable="true"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.nationalCode">
                            <availability visible="true" enable="true" required="true" editable="true"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.countryCode">
                            <availability visible="true" enable="true" required="true" editable="true"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.regionType">
                            <availability visible="true" enable="true" required="true" editable="true"/>
                        </parameter>
                    </parameters>
                    <executeRule name="add" title="新增区划" kind="FUNCTION" type="func:cn.byteawake.ap.oms/add">
                        <pre>
                            <executionRule name="initTimeAxis" title="初始化时间轴" kind="MODIFY_OBJECT"
                                type="cn.byteawake.ap.basedoc.AdministrativeRegion" ordinal="1"/>
                        </pre>
                    </executeRule>
                </action>

                <action name="modify" title="修改区划" kind="modify"
                        requestType="cn.byteawake.ap.basedoc.AdministrativeRegion">
                    <parameters>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.code">
                            <availability visible="true" enable="false" required="false" editable="false"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.nationalCode">
                            <availability visible="true" enable="false" required="false" editable="false"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.countryCode">
                            <availability visible="true" enable="false" required="false" editable="false"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.regionType">
                            <availability visible="true" enable="true" required="false" editable="true"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.shortName">
                            <availability visible="true" enable="true" required="false" editable="true"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.pinyin">
                            <availability visible="true" enable="true" required="false" editable="true"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.pinyinShort">
                            <availability visible="true" enable="true" required="false" editable="true"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.longitude">
                            <availability visible="true" enable="true" required="false" editable="true"/>
                        </parameter>
                        <parameter ref="cn.byteawake.ap.basedoc.AdministrativeRegion.latitude">
                            <availability visible="true" enable="true" required="false" editable="true"/>
                        </parameter>
                    </parameters>
                    <executeRule name="modify" title="修改区划" kind="FUNCTION" type="func:cn.byteawake.ap.oms/modify"/>
                </action>

                <action name="delete" title="删除区划" kind="delete">
                    <executeRule name="delete" title="删除区划" kind="FUNCTION" type="func:cn.byteawake.ap.oms/delete"/>
                </action>

                <action name="list" title="列表" kind="list">
                    <executeRule name="list" title="列表" kind="FUNCTION" type="func:cn.byteawake.ap.oms/list"/>
                </action>

                <action name="detail" title="详情" kind="detail">
                    <executeRule name="detail" title="详情" kind="FUNCTION" type="func:cn.byteawake.ap.oms/detail"/>
                </action>

                <action name="querytree" title="树查询" kind="querytree">
                    <executeRule name="querytree" title="树查询" kind="FUNCTION" type="func:cn.byteawake.ap.oms/querytree"/>
                </action>

                <action name="import" title="导入" kind="add">
                    <executeRule name="import" title="导入" kind="FUNCTION" type="func:cn.byteawake.ap.oms/save"/>
                </action>

                <action name="enable" title="启用" kind="enable">
                    <executeRule name="enable" title="启用" kind="FUNCTION" type="func:cn.byteawake.ap.oms/save"/>
                </action>

                <action name="stop" title="停用" kind="stop">
                    <executeRule name="stop" title="停用" kind="FUNCTION" type="func:cn.byteawake.ap.oms/save"/>
                </action>

                <action name="refer" title="参照" kind="refer">
                    <executeRule name="refer" title="参照" kind="FUNCTION" type="func:cn.byteawake.ap.oms/list"/>
                </action>
            </actions>
        </class>

    </ontology>

</ontologies>
