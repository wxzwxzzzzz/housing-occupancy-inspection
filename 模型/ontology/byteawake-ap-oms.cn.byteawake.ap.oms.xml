<?xml version="1.0" encoding="UTF-8"?>
<ontologies xmlns="http://byteawake.cn/ontology"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://byteawake.cn/ontology oms.xsd">
    <ontology title="公共元数据" namespace="cn.byteawake.ap.oms" serviceDomain="byteawake-ap-oms">
        <!-- ============================================ -->
        <!--  导入依赖                                    -->
        <!-- ============================================ -->
        <import namespace="cn.byteawake.ap.oql"/>

        <!-- ============================================ -->
        <!--  公共业务规则规范                             -->
        <!-- ============================================ -->
        <businessRuleSpec>
            <functions>
                <function name="now" title="当前时间" functionType="func:cn.byteawake.ap.oms/now">
                    <applyScopes>
                        <applyScope namespace="*"/>
                    </applyScopes>
                </function>
            </functions>
        </businessRuleSpec>

        <!-- ============================================ -->
        <!--  动作类型                                    -->
        <!-- ============================================ -->
        <typedef name="Phone" title="手机号" baseType="String" length="20" pattern="^1[3-9][0-9]{9}$"/>
        <typedef name="Email" title="邮箱" baseType="String" length="100" pattern="^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"/>

        <actionKinds>
            <actionKind name="add" title="新增"/>
            <actionKind name="modify" title="修改"/>
            <actionKind name="delete" title="删除"/>
            <actionKind name="copy" title="复制"/>
            <actionKind name="detail" title="详情"/>
            <actionKind name="list" title="列表"/>
            <actionKind name="listdetail" title="列表详情"/>
            <actionKind name="query" title="查询"/>
            <actionKind name="querytree" title="树查询"/>
            <actionKind name="audit" title="审核"/>
            <actionKind name="unaudit" title="弃审"/>
            <actionKind name="close" title="关闭"/>
            <actionKind name="open" title="打开"/>
            <actionKind name="check" title="校验"/>
            <actionKind name="lineclose" title="行关闭"/>
            <actionKind name="lineopen" title="行打开"/>
            <actionKind name="movefirst" title="移至首条"/>
            <actionKind name="movelast" title="移至末条"/>
            <actionKind name="movenext" title="下一条"/>
            <actionKind name="moveprev" title="上一条"/>
            <actionKind name="invalid" title="作废"/>
            <actionKind name="submit" title="提交"/>
            <actionKind name="unsubmit" title="取消提交"/>
            <actionKind name="stop" title="停用"/>
            <actionKind name="enable" title="启用"/>
            <actionKind name="refer" title="参照"/>
            <actionKind name="referrefresh" title="参照刷新"/>
            <actionKind name="pullandpush" title="拉推单"/>
            <actionKind name="push" title="推单"/>
            <actionKind name="pull" title="拉单"/>
            <actionKind name="backwrite" title="回写"/>
            <!-- 认证业务动作类别 -->
            <actionKind name="signup" title="注册"/>
            <actionKind name="authenticate" title="认证"/>
            <actionKind name="verify" title="验证"/>
            <actionKind name="recover" title="恢复"/>
            <actionKind name="logout" title="登出"/>
            <actionKind name="sendOTP" title="发送一次性密码"/>
            <actionKind name="sendMagicLink" title="发送魔法链接"/>
            <actionKind name="resend" title="重发确认"/>
            <actionKind name="challenge" title="挑战"/>
            <actionKind name="reauthenticate" title="重新认证"/>
            <actionKind name="linkIdentity" title="绑定身份"/>
            <actionKind name="getOptions" title="获取选项"/>
            <actionKind name="initiateSSO" title="发起SSO"/>
            <actionKind name="consumeACS" title="消费ACS"/>
            <actionKind name="authorize" title="授权"/>
            <actionKind name="consent" title="同意"/>
            <actionKind name="issueToken" title="签发令牌"/>
            <actionKind name="refresh" title="刷新令牌"/>
            <actionKind name="authenticateWithPasskey" title="Passkey无密码登录"/>
            <actionKind name="exchangeCodeForSession" title="PKCE交换"/>
            <actionKind name="regenerateSecret" title="重新生成密钥"/>
            <actionKind name="lockAccount" title="锁定账户"/>
            <actionKind name="unlockAccount" title="解锁账户"/>
            <actionKind name="oauthAuthorize" title="OAuth授权请求"/>
            <actionKind name="oauthConsent" title="OAuth用户同意"/>
            <actionKind name="oauthIssueToken" title="OAuth签发令牌"/>
            <actionKind name="revokeConsent" title="撤销授权"/>
            <!-- PRH 保障监管业务动作类别 -->
            <actionKind name="archive" title="归档"/>
            <actionKind name="invite" title="邀请"/>
            <actionKind name="checkin" title="打卡"/>
            <actionKind name="terminate" title="终止"/>
            <actionKind name="expire" title="到期"/>
            <actionKind name="suspend" title="暂停"/>
            <actionKind name="resume" title="恢复"/>
            <actionKind name="approve" title="审批通过"/>
            <actionKind name="reject" title="审批驳回"/>
        </actionKinds>

        <!-- ============================================ -->
        <!--  公共函数定义                                -->
